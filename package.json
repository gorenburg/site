    "@types/node": "^22.20.5",
    "bigger-picture": "^1.1.20",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "mdsvex": "^1.0.1",
    "npm-check-updates": "^23.1.1",
    "prettier": "^3.10.1",
    "prettier-plugin-svelte": "^4.2.0",
